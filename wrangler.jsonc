{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycodingjourney",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // workers.dev only. Do not add `routes` or a custom domain here.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference used by the in-isolate ISR revalidation queue.
  // No extra resource to create: the service name is this Worker.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mycodingjourney"
    }
  ],
  // Optional. ISR keeps working from static assets when this is absent.
  // Create the bucket, then uncomment. See MIGRATION.md.
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "mycodingjourney-isr"
  //   }
  // ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
